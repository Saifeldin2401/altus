# Copy to .env.local and fill in. Only these variables are read by the app.
# See docs/HANDOVER.md section 5 for details.

# Required
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=http://localhost:5173

# Optional
VITE_CERTIFICATE_VERIFY_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
VITE_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=
VITE_SENTRY_SEND_DEFAULT_PII=false
VITE_VAPID_PUBLIC_KEY=
VITE_MAX_SESSION_AGE_MS=
VITE_ALLOWED_ORIGINS=

# Build only (source-map upload to Sentry)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
